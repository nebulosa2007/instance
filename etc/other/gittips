[user]
    email =
    name =
[alias]
    bugspaces = !git diff-tree --check $(git hash-object -t tree /dev/null) HEAD
    aurinit = !git -c init.defaultBranch=master clone ssh://aur@aur.archlinux.org/$1.git
[core]
    repositoryformatversion = 0
    filemode = true
    bare = false
    logallrefupdates = true
    whitespace = trailing-space,space-before-tab,tab-in-indent,cr-at-eo
