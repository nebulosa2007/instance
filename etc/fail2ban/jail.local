[DEFAULT]
ignoreip  = 127.0.0.1/8 192.168.1.0/24
maxretry  = 1
findtime  = 10m
bantime   = 1d
banaction = nftables[type=allports]
backend   = auto

action = %(action_)s
         telegram-geo[name=%(__name__)s, logpath="%(logpath)s"]

[nginx-444]
enabled   = true
filter    = nginx-444
port      = http,https
logpath   = /var/log/nginx/fallback_access.log

[recidive]
enabled   = true
filter    = recidive
backend   = systemd
banaction = nftables[type=allports]
maxretry  = 2
findtime  = 30d
bantime   = 30d
